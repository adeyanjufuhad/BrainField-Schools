# Server-only values. Copy to .env.local and populate through your Neon console.
# Use a restricted application database role; never expose this URL in the browser.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Auth service account for administrator password resets. Create with: npm run auth:service-account
NEON_AUTH_SERVICE_EMAIL=
NEON_AUTH_SERVICE_PASSWORD=

# Future private object storage and payment configuration will be added with those modules.
